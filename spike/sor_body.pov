// pingu.pov's BodyProfile, verbatim: the fixture for sor-silhouette-check.bat. The tilt shows
// the caps and the waist to the camera so the spline's in-between shape is what the comparison
// measures, not just the outline of a lathe seen side-on.
sor {
  8,
  <0.14, -0.12>,
  <0.03,  0.02>,
  <0.34,  0.14>,
  <0.508, 0.42>,
  <0.472, 0.84>,
  <0.385, 1.24>,
  <0.03,  1.50>,
  <0.14,  1.64>
  sturm
  pigment { color rgb <0.2, 0.4, 0.8> }
  rotate <35, 0, 15>
}
